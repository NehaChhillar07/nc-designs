# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code session state
.claude/

# one-off QA / measurement scratch scripts at the repo root.
# `npm run lint` is bare eslint over the cwd and tsconfig includes **/*.ts, so a
# stray helper here lands in the lint graph and turns the build red. Keep them
# out of the repo entirely -- see commit bafbf2c.
/_*.cjs
/_*.mjs
/_*.ts

# agent instruction files: kept locally, not published
# (next dev regenerates AGENTS.md on every run)
AGENTS.md
CLAUDE.md
